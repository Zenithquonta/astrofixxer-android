<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the preview (GitHub download) and debug builds can update themselves. Google Play forbids self-updating apps, so the
  release build has neither this permission nor this provider (they are merged in from here, not from the main manifest).
  Keep app/src/debug/AndroidManifest.xml and both res/xml/update_paths.xml files identical to these.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the in-app updater open Android's installer, which always asks the user. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Hands the checked update file (in files/updates/) to the installer. Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
